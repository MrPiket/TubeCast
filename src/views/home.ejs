<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TubeCast</title>
  <link rel="icon" type="image/svg+xml" href="/tubecast-initials.svg">
  <link rel="stylesheet" href="/style.css?v=2">
</head>
<body>
  <header>
    <h1><a href="/"><svg class="logo-img" width="281" height="73" viewBox="0 0 281 73" fill="none" xmlns="http://www.w3.org/2000/svg"><text x="0" y="74" dominant-baseline="ideographic" textLength="274.0234375" lengthAdjust="spacingAndGlyphs" style="text-transform: capitalize; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 400; font-size: 60px; fill: rgb(0, 184, 148);">TubeCast</text></svg><svg class="logo-img-mobile" width="84" height="73" viewBox="0 0 84 73" fill="none" xmlns="http://www.w3.org/2000/svg"><text x="0" y="74" dominant-baseline="ideographic" textLength="75.78125" lengthAdjust="spacingAndGlyphs" style="text-transform: capitalize; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 400; font-size: 60px; fill: rgb(0, 184, 148);">TC</text></svg><span class="logo-text">TubeCast</span></a></h1>
    <nav>
      <a href="/">New Feed</a>
      <a href="/subscriptions">Subscriptions</a>
    </nav>
  </header>
  <main>
    <div class="card">
      <h2>Create a Podcast Feed</h2>
      <p style="color: var(--text-muted); margin-bottom: 1rem;">
        Paste a YouTube channel, playlist, or video URL to generate an RSS feed.
      </p>
      <form id="create-form" method="POST" action="/subscriptions/create">
        <div class="form-group">
          <label for="url">YouTube URL</label>
          <input type="url" id="url" name="url" required
                 placeholder="https://www.youtube.com/@channel or playlist URL">
        </div>
        <button type="submit" class="btn btn-primary">Create Feed</button>
      </form>
    </div>

    <% if (typeof result !== 'undefined' && result) { %>
      <div class="result-box">
        <p>Feed created successfully!</p>
        <strong><%= result.title %></strong>
        <div class="feed-url" style="margin-top: 0.5rem;">
          <span id="feed-url-text"><%= result.feedUrl %></span>
          <button type="button" class="btn btn-secondary" onclick="copyFeedUrl()">Copy</button>
        </div>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="card" style="border-color: var(--accent); margin-top: 1rem;">
        <p style="color: var(--accent); margin: 0;"><%= error %></p>
      </div>
    <% } %>
  </main>
  <footer>TubeCast &mdash; YouTube to Podcast RSS</footer>
  <script>
    function copyFeedUrl() {
      var text = document.getElementById('feed-url-text').textContent;
      navigator.clipboard.writeText(text).then(function() {
        var btn = document.querySelector('.feed-url button');
        btn.textContent = 'Copied!';
        setTimeout(function() { btn.textContent = 'Copy'; }, 2000);
      });
    }
  </script>
</body>
</html>
